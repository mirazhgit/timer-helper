{
  "name": "timer-helper",
  "displayName": "Timer Helper",
  "description": "Простой секундомер прямо в редакторе VS Code",
  "version": "1.0.4",
  "publisher": "MIRAZHVS",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "timer",
    "stopwatch",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "timerHelper.start",
        "title": "Timer: Запустить секундомер"
      },
      {
        "command": "timerHelper.stop",
        "title": "Timer: Остановить секундомер"
      },
      {
        "command": "timerHelper.reset",
        "title": "Timer: Сбросить секундомер"
      },
      {
        "command": "timerHelper.showMenu",
        "title": "Timer: Показать меню"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0"
  }
}